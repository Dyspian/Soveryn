# Local PostGIS. The password is for the Docker compose database only.
DATABASE_URL=postgres://soveryn:soveryn@localhost:5432/soveryn

# Used to sign session cookies. Generate a long random string before deployment.
SESSION_SECRET=replace-with-a-random-string-at-least-32-characters

# Comma-separated emails that receive the admin role on sign-in.
ADMIN_EMAILS=

# Optional public Discord invite. Leave unset until a real server exists.
# SOVERYN_DISCORD_URL=
